{
  "name": "orbital-engine",
  "version": "1.2.0",
  "description": "A true-scale orbital mechanics rendering engine for react-three-fiber — real Keplerian orbits and single-snapshot fixed positions in one data contract, with a pixel-floor system so true-to-scale bodies stay visible.",
  "type": "module",
  "license": "MIT",
  "author": "Bevan Coleman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bevancoleman/orbital-engine.git"
  },
  "homepage": "https://github.com/bevancoleman/orbital-engine#readme",
  "bugs": "https://github.com/bevancoleman/orbital-engine/issues",
  "keywords": [
    "three.js",
    "react-three-fiber",
    "orbital-mechanics",
    "solar-system",
    "kepler",
    "astronomy",
    "3d",
    "webgl"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "provenance": true
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "docs": "typedoc",
    "prepare": "npm run build",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e",
    "plot:camera-route": "tsx scripts/plotCameraRoute.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@react-three/drei": ">=9",
    "@react-three/fiber": ">=8",
    "react": ">=18",
    "three": ">=0.150"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "three": "^0.182.0",
    "ts-jest": "^29.4.6",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
