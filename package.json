{
  "name": "orbital-engine",
  "version": "1.5.0",
  "description": "A true-scale orbital mechanics rendering engine for react-three-fiber — real Keplerian orbits and single-snapshot fixed positions in one data contract, with a pixel-floor system so true-to-scale bodies stay visible.",
  "type": "module",
  "license": "MIT",
  "author": "Bevan Coleman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bevancoleman/orbital-engine.git"
  },
  "homepage": "https://github.com/bevancoleman/orbital-engine#readme",
  "bugs": "https://github.com/bevancoleman/orbital-engine/issues",
  "keywords": [
    "three.js",
    "react-three-fiber",
    "orbital-mechanics",
    "solar-system",
    "kepler",
    "astronomy",
    "3d",
    "webgl"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "provenance": true
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "docs": "typedoc",
    "prepare": "npm run build",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e scripts",
    "plot:camera-route": "tsx scripts/plotCameraRoute.ts",
    "bench:scene": "esbuild scripts/benchmarkScene.tsx --bundle --platform=node --format=esm --external:jsdom --alias:three=./node_modules/three/build/three.module.js --define:process.env.NODE_ENV=\\\"production\\\" --outfile=artifacts/bench/benchmarkScene.mjs --log-level=warning && node --expose-gc --max-semi-space-size=256 artifacts/bench/benchmarkScene.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@react-three/drei": "^9.56.5 || ^10.0.0",
    "@react-three/fiber": "^8.13.0 || ^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": ">=0.152.0 <1.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "three": "^0.186.1",
    "ts-jest": "^29.4.6",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
