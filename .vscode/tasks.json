{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "root: build",
      "type": "npm",
      "script": "build",
      "problemMatcher": ["$tsc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "root: typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"],
      "group": "test"
    },
    {
      "label": "root: lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"],
      "group": "test"
    },
    {
      "label": "root: test",
      "type": "npm",
      "script": "test",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "root: test:watch",
      "type": "npm",
      "script": "test:watch",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "root: docs",
      "type": "npm",
      "script": "docs",
      "problemMatcher": []
    },
    {
      "label": "examples/basic: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/examples/basic" },
      "problemMatcher": []
    },
    {
      "label": "examples/basic: dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/examples/basic" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^never-matches$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "examples/basic: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/examples/basic" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "examples/with-models: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/examples/with-models" },
      "problemMatcher": []
    },
    {
      "label": "examples/with-models: dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/examples/with-models" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^never-matches$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "examples/with-models: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/examples/with-models" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "e2e: playwright test",
      "type": "shell",
      "command": "npx playwright test",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
