{
  "version": "0.2.0",
  "configurations": [
    {
      // No google-chrome/chromium binary on this machine — VS Code's
      // "chrome" debug type only auto-detects specific known binary names,
      // so it silently fails to launch without runtimeExecutable pointing
      // it at an actual browser. Vivaldi (this machine's real default
      // browser, /usr/bin/vivaldi) is Chromium-based and speaks the same
      // remote-debugging protocol, so it works as a drop-in target.
      "name": "Debug: examples/basic (Chrome)",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "vivaldi",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/examples/basic",
      "sourceMaps": true,
      "preLaunchTask": "examples/basic: dev server"
    },
    {
      "name": "Debug: examples/with-models (Chrome)",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "vivaldi",
      "url": "http://localhost:5174",
      "webRoot": "${workspaceFolder}/examples/with-models",
      "sourceMaps": true,
      "preLaunchTask": "examples/with-models: dev server"
    },
    {
      "name": "Attach to running dev server (basic, :5173)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/examples/basic"
    },
    {
      "name": "Debug: Jest tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--experimental-vm-modules"],
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": ["--runInBand", "--no-coverage"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "disableOptimisticBPs": true
    },
    {
      "name": "Debug: current Jest test file",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--experimental-vm-modules"],
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": ["--runInBand", "--no-coverage", "${fileBasenameNoExtension}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "disableOptimisticBPs": true
    }
  ]
}
